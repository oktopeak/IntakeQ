INTAKEQ_API_KEY=           # fallback for CI / headless; prefer set_api_key tool
INTAKEQ_API_BASE=          # override default https://intakeq.com/api/v1
MCP_API_KEY=               # Bearer gate on the HTTP /mcp endpoint; required in http mode unless MCP_ALLOW_NO_AUTH=true
MCP_ALLOW_NO_AUTH=         # set true to allow HTTP mode without MCP_API_KEY (local dev only, never with real patient data)
TRANSPORT=                 # stdio (default) | http
MCP_BASE_URL=http://127.0.0.1:3000
PORT=                      # HTTP listen port (default 3000), HTTP transport only
