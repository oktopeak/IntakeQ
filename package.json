{
  "name": "@oktopeak/intakeq-mcp",
  "mcpName": "io.github.oktopeak/intakeq-mcp",
  "version": "1.0.1",
  "description": "IntakeQ/PracticeQ MCP connector with HIPAA §164.312(b) audit logging",
  "type": "module",
  "main": "build/index.js",
  "author": "Oktopeak <office@oktopeak.com> (https://oktopeak.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oktopeak/IntakeQ.git"
  },
  "homepage": "https://github.com/oktopeak/IntakeQ#readme",
  "files": ["build"],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "intakeq-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node build/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["mcp", "intakeq", "practiceq", "healthcare", "hipaa", "phi", "hipaa-audit"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.32",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
